{
  "expo": {
    "name": "Kimbo",
    "slug": "kimbo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.knapsack.kimbo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kimbo uses the camera so you can photograph your meals.",
          "photosPermission": "Kimbo reads the meal photos you choose."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EE"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kimbo uses the microphone so you can say what you ate.",
          "speechRecognitionPermission": "Kimbo turns what you say into a meal to check.",
          "androidSpeechServiceProviders": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Kimbo uses the camera so you can scan your meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "kimbo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
